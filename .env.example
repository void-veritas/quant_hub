# Copy to .env and fill in. .env is gitignored; this file is the committed template.
# Data layer
AWS_ACCESS_KEY_ID=            # S3 mirror s3://yolo-research-ep and the requester-pays HL archives
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
RW_PRO=                       # Robot Wealth API key (YOLO reference values, bulk datasets, funding tail)
SCRAPING_BEE_KEY=             # optional: route venue requests through a rotating IP pool
FMP_API_KEY=                  # optional, equities data
# Live layer (quant_hub.live): the executor container only
LIVE_STORE=./store            # local store root; LIVE_BUCKET mirrors it to S3
LIVE_BUCKET=
HL_ACCOUNT_ADDRESS=           # trading account (sub-account recommended)
HL_AGENT_PRIVATE_KEY=         # API/agent wallet approved for trading only, never the main wallet key
PAPER_EQUITY=1000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=       # numeric user ids allowed to send /status and /pause
